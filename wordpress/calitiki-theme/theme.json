{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "760px", "wideSize": "1180px" },
    "color": {
      "palette": [
        { "slug": "ink", "name": "Encre", "color": "#18373a" },
        { "slug": "coral", "name": "Corail", "color": "#d8755b" },
        { "slug": "sage", "name": "Sauge", "color": "#86b5aa" },
