{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calitiki.com/schemas/visual-intent.v1.schema.json",
  "title": "VisualIntent.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "sourceCreationIntent", "universeId", "characters", "validation"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "calitiki.visual-intent.v1" },
    "sourceCreationIntent": { "$ref": "#/$defs/source" },
    "universeId": { "$ref": "#/$defs/identifier" },
    "characters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/character" }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["builderVersion", "artifactDigest"],
      "properties": {
        "builderVersion": { "const": 1 },
        "artifactDigest": { "$ref": "#/$defs/digest" }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "reference": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractId", "schemaVersion", "artifactDigest"],
      "properties": {
        "contractId": { "const": "calitiki.creation-intent.v1" },
        "schemaVersion": { "const": 1 },
        "artifactDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["characterKey", "profileRef", "role", "kind", "outfitPreference", "ordinaryOutfit", "adventureOutfit", "accommodationIds"],
      "properties": {
        "characterKey": { "$ref": "#/$defs/identifier" },
        "profileRef": { "$ref": "#/$defs/reference" },
        "role": { "enum": ["hero", "guide", "peer", "family", "companion"] },
        "kind": { "enum": ["human", "animal", "fantasy"] },
        "outfitPreference": { "enum": ["preserve_photo", "auto_universe", "selected", "natural_appearance"] },
        "ordinaryOutfit": { "$ref": "#/$defs/outfit" },
        "adventureOutfit": { "$ref": "#/$defs/outfit" },
        "accommodationIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "outfit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stateId", "description", "evidenceDigest"],
      "properties": {
        "stateId": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evidenceDigest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
