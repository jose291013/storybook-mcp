{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calitiki.com/schemas/character-state-timeline.v1.schema.json",
  "title": "CharacterStateTimeline.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "sources", "characters", "scenes", "validation"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "calitiki.character-state-timeline.v1" },
    "sources": {
      "type": "object", "additionalProperties": false,
      "required": ["creationIntentDigest", "visualIntentDigest", "storyConceptDigest"],
      "properties": {
        "creationIntentDigest": { "$ref": "#/$defs/digest" },
        "visualIntentDigest": { "$ref": "#/$defs/digest" },
        "storyConceptDigest": { "$ref": "#/$defs/digest" },
        "worldLawDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "characters": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/character" } },
    "scenes": { "type": "array", "minItems": 5, "maxItems": 24, "items": { "$ref": "#/$defs/scene" } },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["builderVersion", "artifactDigest"],
      "properties": { "builderVersion": { "const": 1 }, "artifactDigest": { "$ref": "#/$defs/digest" } }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "character": {
      "type": "object", "additionalProperties": false,
      "required": ["characterId", "characterKey", "initialState"],
      "properties": {
        "characterId": { "$ref": "#/$defs/id" },
        "characterKey": { "$ref": "#/$defs/id" },
        "initialState": { "$ref": "#/$defs/state" }
      }
    },
    "scene": {
      "type": "object", "additionalProperties": false,
      "required": ["sceneNumber", "beatKey", "events", "statesAfter"],
      "properties": {
        "sceneNumber": { "type": "integer", "minimum": 1, "maximum": 24 },
        "beatKey": { "$ref": "#/$defs/id" },
        "events": { "type": "array", "maxItems": 40, "items": { "$ref": "#/$defs/event" } },
        "statesAfter": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/sceneState" } }
      }
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["outfitStateId", "equipmentStateIds", "knowledgeStateId", "emotionStateId"],
      "properties": {
        "outfitStateId": { "$ref": "#/$defs/id" },
        "equipmentStateIds": { "type": "array", "uniqueItems": true, "maxItems": 12, "items": { "$ref": "#/$defs/id" } },
        "knowledgeStateId": { "$ref": "#/$defs/id" },
        "emotionStateId": { "$ref": "#/$defs/id" }
      }
    },
    "sceneState": {
      "type": "object", "additionalProperties": false,
      "required": ["characterId", "outfitStateId", "equipmentStateIds", "knowledgeStateId", "emotionStateId"],
      "properties": {
        "characterId": { "$ref": "#/$defs/id" },
        "outfitStateId": { "$ref": "#/$defs/id" },
        "equipmentStateIds": { "type": "array", "uniqueItems": true, "maxItems": 12, "items": { "$ref": "#/$defs/id" } },
        "knowledgeStateId": { "$ref": "#/$defs/id" },
        "emotionStateId": { "$ref": "#/$defs/id" }
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["eventId", "characterId", "kind", "fromStateId", "toStateId", "cause"],
      "properties": {
        "eventId": { "$ref": "#/$defs/id" },
        "characterId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["don_outfit", "remove_outfit", "equip", "unequip", "knowledge_change", "emotion_change"] },
        "fromStateId": { "$ref": "#/$defs/id" },
        "toStateId": { "$ref": "#/$defs/id" },
        "cause": { "enum": ["initial_world_state", "story_preparation", "medium_entry", "medium_exit", "semantic_beat"] }
      }
    }
  }
}
