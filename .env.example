# OpenAI
OPENAI_API_KEY=your_key_here
TEXT_MODEL=gpt-4.1-mini
# Quality-first narrative routing. These defaults are applied by the application
# when the variables are absent, so Render overrides are optional.
STORY_ARCHITECT_MODEL=gpt-5.6-sol
STORY_ARCHITECT_REASONING_EFFORT=high
STORY_EDITOR_MODEL=gpt-5.6-sol
STORY_EDITOR_REASONING_EFFORT=high
STORY_PLANNER_MODEL=gpt-5.6-terra
STORY_PLANNER_REASONING_EFFORT=high
STORY_WRITER_MODEL=gpt-5.6-terra
STORY_WRITER_REASONING_EFFORT=medium
UTILITY_TEXT_MODEL=gpt-5.6-luna
UTILITY_REASONING_EFFORT=low
VISION_MODEL=gpt-4.1-mini
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=low
DRAFT_IMAGE_MODEL=gpt-image-2
FINAL_IMAGE_MODEL=gpt-image-1
FINAL_IMAGE_QUALITY=high
# Used whenever one or more character reference images are available.
# gpt-image-2 preserves every reference at high fidelity; keep quality=low for economical drafts.
REFERENCE_IMAGE_MODEL=gpt-image-2
# Low-cost technical inspection catches corrupted, blank or decoder-broken draft images before they reach the reader.
IMAGE_CONTENT_QA_ENABLED=true
IMAGE_QA_MODEL=gpt-4.1-mini
IMAGE_LIKENESS_QA_ENABLED=true
IMAGE_GENERATION_ATTEMPTS=2
# Economical semantic check for the central action, actors, quantities and scale.
# Set false only for local troubleshooting.
IMAGE_SCENE_QA_ENABLED=true
# Bound every external AI request so a preview cannot remain stuck indefinitely.
OPENAI_REQUEST_TIMEOUT_MS=180000
OPENAI_REQUEST_MAX_RETRIES=0
# Whole-book text reconciliation and scene-contract planning can return a much larger JSON object.
OPENAI_STORY_TIMEOUT_MS=360000
OPENAI_STORY_MAX_RETRIES=0
# Scenario architecture has a separate longer bound because high reasoning can
# exceed the whole-book planning latency. The durable worker survives restarts.
OPENAI_SCENARIO_TIMEOUT_MS=600000
OPENAI_SCENARIO_MAX_RETRIES=0
# Durable scenario runs are claimed by the web process and resume after an
# expired lease when Render restarts. Disable only for local troubleshooting.
STORY_SCENARIO_WORKER_ENABLED=true
STORY_SCENARIO_WORKER_INTERVAL_MS=2000
OPENAI_IMAGE_TIMEOUT_MS=180000
OPENAI_IMAGE_MAX_RETRIES=0
OPENAI_QA_TIMEOUT_MS=60000
OPENAI_QA_MAX_RETRIES=0
# Private editorial sensitivity classification. "off" preserves the existing flow.
# "observe" stores a versioned profile without changing the customer journey.
# "guided" adds immutable narrative guidance for levels 2 and 3, asks the adult
# to acknowledge level 3, and pauses acute-safety requests before generation.
STORY_SENSITIVITY_MODE=off
# Classification falls back to deterministic multilingual rules instead of
# delaying the parent-intention assistant when the classifier is unavailable.
STORY_SENSITIVITY_TIMEOUT_MS=8000
# Separate child sexual-safety gate. "observe" records bounded decisions without
# changing the journey; "enforce" blocks exploitative normalization and pauses a
# possible abuse disclosure before persistence, generation or credit reservation.
CHILD_SAFETY_MODE=off
CHILD_SAFETY_TIMEOUT_MS=10000
OPENAI_MODERATION_MODEL=omni-moderation-latest
# Paid AI narration. Uses the dedicated Speech endpoint so only the exact page text is spoken.
# Audio is generated only after the signed WooCommerce order is paid.
NARRATION_TTS_MODEL=gpt-4o-mini-tts

# App
BASE_URL=https://storybook-mcp.onrender.com
PORT=3000

# Production persistence. Leave DATABASE_URL empty for local JSON development.
DATABASE_URL=
DATABASE_SSL=false
DRAFT_SESSION_DAYS=7
DRAFT_TTL_DAYS=7
CUSTOMER_SESSION_DAYS=7

# Preview wallet. Keep disabled until at least one promotion code or the WooCommerce credit product is configured.
PREVIEW_ENTITLEMENTS_ENABLED=false
# A generation with no progress beyond this duration is recoverable without a second charge.
PREVIEW_STALE_MINUTES=15
# Durable generation leases are checked after every Render start and on this interval.
# An expired preview is changed into a free resumable interruption instead of remaining frozen.
GENERATION_RECOVERY_ENABLED=true
GENERATION_RECOVERY_INTERVAL_MS=60000
GENERATION_RECOVERY_BATCH_SIZE=10
# A targeted spread change interrupted by a Render restart becomes freely retryable after this no-progress period.
PREVIEW_MODIFICATION_STALE_MINUTES=15
# Automatically resume private asset cleanup after a project has left the customer library.
PROJECT_DELETION_CLEANUP_ENABLED=true
PROJECT_DELETION_CLEANUP_INTERVAL_MS=60000
PROJECT_DELETION_CLEANUP_MAX_ATTEMPTS=8
PROJECT_DELETION_CLEANUP_BATCH_SIZE=10
# Optional migration cutoff for the one-time free rebuild of previews affected by legacy ephemeral photo uploads.
REFERENCE_PHOTO_RECOVERY_CUTOFF=2026-07-19T13:00:00.000Z
# Comma-separated CODE:AMOUNT_IN_EURO_CENTS values. Codes are case-insensitive and redeemable once per Woo customer.
# Example: CALITIKI250:250,CALITIKI500:500
PREVIEW_PROMO_CODES=
# WooCommerce product/page used to buy wallet credit before a preview.
WOOCOMMERCE_CREDITS_URL=

# Shared with the Calitiki Bridge WordPress plugin. Use the exact secret shown in WooCommerce > Calitiki Bridge.
WOOCOMMERCE_BRIDGE_SECRET=
# Public bridge URL shown by the WordPress plugin, for example https://calitiki.com/?calitiki_connect=1
WOOCOMMERCE_BRIDGE_URL=
# Optional. When empty, the checkout entry point is derived from WOOCOMMERCE_BRIDGE_URL.
WOOCOMMERCE_CHECKOUT_URL=
# Keep the printed-book format visible but unavailable until a production supplier is ready.
PRINT_BOOK_ENABLED=false

# Private personalized eBook and preview-page storage. Production/Render requires an S3-compatible private bucket.
PRIVATE_STORAGE_BACKEND=s3
PRIVATE_STORAGE_ENDPOINT=
PRIVATE_STORAGE_REGION=auto
PRIVATE_STORAGE_BUCKET=
PRIVATE_STORAGE_ACCESS_KEY_ID=
PRIVATE_STORAGE_SECRET_ACCESS_KEY=
PRIVATE_STORAGE_FORCE_PATH_STYLE=false
# Use a different random secret from the WooCommerce bridge secret when possible (minimum 32 characters).
DELIVERY_SIGNING_SECRET=
# Optional dedicated secret for revocable family-reader sessions. When empty, DELIVERY_SIGNING_SECRET is used.
FAMILY_SHARE_SIGNING_SECRET=
# Lifetime of emailed download links. A connected customer can request a fresh link from My creations.
EBOOK_LINK_DAYS=7
# Keep native Sharp allocations predictable on small Render instances.
SHARP_CONCURRENCY=1
SHARP_CACHE_MEMORY_MB=16
